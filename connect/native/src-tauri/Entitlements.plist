<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- The PyInstaller onefile bridge extracts libpython and extension modules at start.
       Ad-hoc signed code has no Team ID, so hardened-runtime library validation rejects
       them and the bridge exits before reporting readiness. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- Bundled Node.js (V8) needs JIT under the hardened runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
</dict>
</plist>
