{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Mdtero Connect Debug",
  "version": "0.1.0",
  "identifier": "com.mdtero.connect.debug",
  "build": { "frontendDist": "../bootstrap" },
  "app": {
    "windows": [],
    "withGlobalTauri": false,
    "security": {
      "capabilities": [],
      "csp": "default-src 'none'; style-src 'self'; base-uri 'none'; form-action 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "nsis"],
    "externalBin": ["binaries/mdtero-connect-bridge"],
    "resources": { "resources/runtime/": "runtime/" },
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": { "minimumSystemVersion": "12.0", "signingIdentity": "-" },
    "windows": { "nsis": { "installMode": "currentUser" } }
  }
}
