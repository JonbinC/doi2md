{
  "version": 1,
  "manifestUrl": "https://mdtero.com/install/manifest.json",
  "installGuideUrl": "https://api.mdtero.com/skills/install.md",
  "installScriptUrl": "https://mdtero.com/install.sh",
  "extensionDevZipUrl": "https://mdtero.com/downloads/mdtero-extension-dev.zip",
  "quickInstallCommand": "uv tool install --force --reinstall git+https://github.com/JonbinC/doi2md.git && mdtero setup",
  "scriptInstallCommand": "curl -Ls https://mdtero.com/install.sh | sh",
  "pypiInstallCommand": "uv tool install mdtero",
  "cliCommand": "mdtero",
  "accountBoundaryNote": "Mdtero Account is the control plane for Mdtero API keys, quota, billing, history, and install prompts. Academic source keys stay in local mdtero CLI configuration. The runtime CLI and agent skill installer are both provided by the Python mdtero package.",
  "cli": {
    "packageName": "mdtero",
    "packageVersion": "0.2.0a24",
    "packageManager": "uv",
    "runtimeInstallCommand": "uv tool install --force --reinstall git+https://github.com/JonbinC/doi2md.git",
    "scriptInstallCommand": "curl -Ls https://mdtero.com/install.sh | sh",
    "pipxInstallCommand": "pipx install --force git+https://github.com/JonbinC/doi2md.git",
    "pipUserInstallCommand": "python3 -m pip install --user --force-reinstall git+https://github.com/JonbinC/doi2md.git",
    "pypiInstallCommand": "uv tool install mdtero",
    "runtimeCommand": "mdtero",
    "skillDetectCommand": "mdtero agent detect --json",
    "skillInteractiveInstallCommand": "mdtero agent install --interactive",
    "skillInstallCommand": "mdtero agent install --target <target>"
  },
  "targets": [
    {
      "target": "openclaw",
      "label": "OpenClaw",
      "description": "OpenClaw stays on a separate ClawHub route. Normal parsing still uses Mdtero's Python CLI/API and backend parser.",
      "descriptionZh": "OpenClaw \u4fdd\u6301\u72ec\u7acb\u7684 ClawHub \u8def\u7ebf\u3002\u5e38\u89c4\u89e3\u6790\u4ecd\u8d70 Mdtero Python CLI/API \u548c\u540e\u7aef\u89e3\u6790\u3002",
      "installCommand": "clawhub install mdtero",
      "skillDirectory": ".openclaw/skills/mdtero"
    },
    {
      "target": "claude_code",
      "label": "Claude Code",
      "description": "Best for workspaces that keep Mdtero in .claude/skills.",
      "descriptionZh": "\u9002\u5408\u628a Mdtero \u653e\u8fdb .claude/skills \u7684 Claude Code \u5de5\u4f5c\u533a\u3002",
      "installCommand": "curl -Ls https://mdtero.com/install.sh | sh -s -- --agent claude_code",
      "skillDirectory": ".claude/skills/mdtero",
      "skillInstallCommand": "mdtero agent install --target claude_code"
    },
    {
      "target": "codex",
      "label": "Codex",
      "description": "Best for workspaces that keep Mdtero in .codex/skills.",
      "descriptionZh": "\u9002\u5408\u628a Mdtero \u653e\u8fdb .codex/skills \u7684 Codex \u5de5\u4f5c\u533a\u3002",
      "installCommand": "curl -Ls https://mdtero.com/install.sh | sh -s -- --agent codex",
      "skillDirectory": ".codex/skills/mdtero",
      "skillInstallCommand": "mdtero agent install --target codex"
    },
    {
      "target": "gemini_cli",
      "label": "Gemini CLI",
      "description": "Best for Gemini CLI setups that keep the workflow in .gemini/skills.",
      "descriptionZh": "\u9002\u5408\u628a\u5de5\u4f5c\u6d41\u653e\u8fdb .gemini/skills \u7684 Gemini CLI \u73af\u5883\u3002",
      "installCommand": "curl -Ls https://mdtero.com/install.sh | sh -s -- --agent gemini_cli",
      "skillDirectory": ".gemini/skills/mdtero",
      "skillInstallCommand": "mdtero agent install --target gemini_cli"
    },
    {
      "target": "hermes",
      "label": "Hermes Agent",
      "description": "Best for Hermes Agent setups that load SKILL.md workflows from ~/.hermes/skills.",
      "descriptionZh": "\u9002\u5408\u4ece ~/.hermes/skills \u52a0\u8f7d SKILL.md \u5de5\u4f5c\u6d41\u7684 Hermes Agent \u73af\u5883\u3002",
      "installCommand": "curl -Ls https://mdtero.com/install.sh | sh -s -- --agent hermes",
      "skillDirectory": ".hermes/skills/mdtero",
      "skillInstallCommand": "mdtero agent install --target hermes",
      "mcpNote": "Run `mdtero mcp serve` when a local agent needs project context over FastMCP."
    },
    {
      "target": "opencode",
      "label": "OpenCode",
      "description": "Best for OpenCode workspaces that keep project skills in .opencode/skills.",
      "descriptionZh": "\u9002\u5408\u628a\u9879\u76ee\u6280\u80fd\u653e\u8fdb .opencode/skills \u7684 OpenCode \u5de5\u4f5c\u533a\u3002",
      "installCommand": "curl -Ls https://mdtero.com/install.sh | sh -s -- --agent opencode",
      "skillDirectory": ".opencode/skills/mdtero",
      "skillInstallCommand": "mdtero agent install --target opencode"
    }
  ],
  "releaseTruth": {
    "source": "website-first",
    "manifestPath": "/install/manifest.json",
    "boundaries": {
      "pythonRuntimeSourceOfTruth": "cli.runtimeInstallCommand",
      "agentSkillInstallSourceOfTruth": "targets[*].skillInstallCommand except openclaw",
      "openclawInstallSourceOfTruth": "targets[target=openclaw]",
      "desktopPublicationMode": "retired from the current public install contract; the active launch path is CLI plus browser extension"
    },
    "current": {
      "cli": {
        "version": "0.2.0a24",
        "packageName": "mdtero",
        "packageManager": "uv",
        "installCommand": "uv tool install --force --reinstall git+https://github.com/JonbinC/doi2md.git",
        "scriptInstallCommand": "curl -Ls https://mdtero.com/install.sh | sh",
        "pipxInstallCommand": "pipx install --force git+https://github.com/JonbinC/doi2md.git",
        "pipUserInstallCommand": "python3 -m pip install --user --force-reinstall git+https://github.com/JonbinC/doi2md.git",
        "pypiInstallCommand": "uv tool install mdtero",
        "skillDetectCommand": "mdtero agent detect --json",
        "skillInteractiveInstallCommand": "mdtero agent install --interactive",
        "skillInstallCommand": "mdtero agent install --target <target>",
        "installTargets": [
          "claude_code",
          "codex",
          "gemini_cli",
          "hermes",
          "opencode"
        ]
      }
    }
  }
}
